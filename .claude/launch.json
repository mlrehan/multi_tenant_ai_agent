{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 3000
    },
    {
      "name": "backend-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "iam_platform.asgi"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "test-website-3010",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3010",
        "--directory",
        "tests"
      ],
      "port": 3010,
      "autoPort": false
    }
  ]
}
