# Copy to .env for local development. See docs/21-configuration-and-secrets.md.
# Values here are placeholders -- plain env vars are fine for `development`
# only; staging/production must use SECRET_PROVIDER=... with `secret://` refs.
#
# This ONE file is read by two different things, and every name below is
# spelled to work for both without duplication:
#   1. The application itself (`Settings`, in core/config.py) -- reads the
#      nested `__`-delimited names (`JWT__ISSUER`, `DATABASE__PASSWORD`, ...).
#   2. `docker compose -f docker-compose.dev.yml`, for its own `${VAR}`
#      substitution -- reads those SAME `__`-delimited names directly. Only a
#      handful of names below (`POSTGRES_SUPERUSER_PASSWORD`,
#      `APP_TENANT_PASSWORD`, `APP_PLATFORM_PASSWORD`) exist purely for
#      compose/the Postgres container and are never read by the app -- those
#      are the only ones NOT spelled with `__`, because they have no
#      corresponding Settings field, under any spelling.
#
# Recommended path: `docker compose -f docker-compose.dev.yml up -d --build`
# runs everything (Postgres, Redis, Qdrant, the API and the worker) from this
# one file -- see DEPLOYMENT.md Part A. Running the API/worker natively with
# `python`/`celery` instead is still supported (DEPLOYMENT.md's "Running
# natively" section) and reads this same file.

ENVIRONMENT=development

# --- Compose-only: read by `docker compose`, never by the app itself -------
# Seeds the Postgres superuser and the two application database roles the
# first time the `postgres` container's data volume is created (see
# docker/postgres-init/01-roles.sh). Any strong local values are fine.
POSTGRES_SUPERUSER_PASSWORD=dev_only_superuser_password
APP_TENANT_PASSWORD=dev_only_password
APP_PLATFORM_PASSWORD=dev_only_password
# env | aws_secrets_manager. `env` is REJECTED at startup when
# ENVIRONMENT=production (it would mean secrets sit in plain env vars).
# vault/azure_key_vault/gcp_secret_manager are accepted by Settings but have
# no adapter yet -- selecting one raises NotImplementedError at startup.
SECRET_PROVIDER=env

# Deliberate opt-out from "production must use a real secret store". Only read
# when ENVIRONMENT=production and SECRET_PROVIDER=env; ignored otherwise.
# Set it for a single-server deployment that keeps its secrets in this file
# with chmod 600 -- see DEPLOYMENT.md Step 4 for what that trades away.
ALLOW_PLAINTEXT_SECRETS=false
# Only read when SECRET_PROVIDER=aws_secrets_manager.
AWS_REGION=us-east-1

# `localhost:15432` is where `docker-compose.dev.yml` publishes the
# `postgres` container's port 5432 -- NOT the container's own internal port,
# and NOT the same as production's 5432 (production publishes no database
# port to the host at all). If you change the published port in
# docker-compose.dev.yml, change it here too.
DATABASE__HOST=localhost
DATABASE__PORT=15432
DATABASE__NAME=iam_platform
# Three distinct roles -- see docker/postgres-init/01-roles.sh and
# docs/18-schema-rls-and-migrations.md. app_tenant is RLS-subject (normal app
# traffic); app_platform is BYPASSRLS (Platform Service Layer only);
# postgres is the table-owning role migrations run as. The three passwords
# below must match POSTGRES_SUPERUSER_PASSWORD/APP_TENANT_PASSWORD/
# APP_PLATFORM_PASSWORD above -- that is what the `postgres` container is
# actually seeded with on first boot.
DATABASE__USER=app_tenant
DATABASE__PASSWORD=dev_only_password
DATABASE__PLATFORM_USER=app_platform
DATABASE__PLATFORM_PASSWORD=dev_only_password
DATABASE__MIGRATOR_USER=postgres
DATABASE__MIGRATOR_PASSWORD=dev_only_superuser_password

# `localhost:56379` -- same story as DATABASE__PORT above; matches the port
# docker-compose.dev.yml publishes redis on.
REDIS__URL=redis://localhost:56379/0

JWT__ISSUER=https://auth.iam-platform.local
JWT__AUDIENCE=iam-platform-api
# Generate a dev keypair with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT__PRIVATE_KEY_PEM=
JWT__PUBLIC_KEY_PEM=

# Port 18000, not 8000: that's where docker-compose.dev.yml publishes the API
# container's port 8000 to your host. Running the API natively instead of in
# Docker? Use 8000 here (see DEPLOYMENT.md's "Running natively" section).
OAUTH_GOOGLE__ENABLED=false
OAUTH_GOOGLE__CLIENT_ID=
OAUTH_GOOGLE__CLIENT_SECRET=
OAUTH_GOOGLE__REDIRECT_URI=http://localhost:18000/v1/auth/oauth/google/callback

OAUTH_FACEBOOK__ENABLED=false
OAUTH_FACEBOOK__CLIENT_ID=
OAUTH_FACEBOOK__CLIENT_SECRET=
OAUTH_FACEBOOK__REDIRECT_URI=http://localhost:18000/v1/auth/oauth/facebook/callback

# Envelope-encryption data key for provider credentials (docs/16-schema-ai-resources.md).
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In staging/production this must be a secret:// reference, not a literal key.
ENCRYPTION__DATA_KEY=

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Where third-party pages reach this API. Used only to build the embed snippet
# a tenant copies for the public chat widget -- the admin console cannot work
# it out, since it talks to the API through a server-side proxy and ships no
# public backend origin. Left empty the API uses the request's own base URL,
# which is right locally; set it explicitly behind a reverse proxy.
PUBLIC_API_BASE_URL=

LOG_LEVEL=INFO

# Coarse per-IP edge rate limit (api/middleware/rate_limit.py). Distinct from
# the per-account login throttling in LOCKOUT__* -- see
# docs/22-deployment-and-operations.md for why both exist.
RATE_LIMIT__REQUESTS_PER_WINDOW=300
RATE_LIMIT__WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Knowledge-base ingestion and RAG (Phases 10-14)
# See docs/24-knowledge-base-ingestion-and-rag.md.
#
# All of these are optional: with empty credentials the IAM platform boots and
# serves authentication/authorization normally, and only the RAG features are
# unavailable. Note the naming -- this project routes every setting through a
# nested group (DATABASE__HOST, JWT__ISSUER, ...), so the flat `EMBEDDING_MODEL`
# and `OPENAI_MODEL` names become OPENAI__EMBEDDING_MODEL and OPENAI__CHAT_MODEL.
# ---------------------------------------------------------------------------

# Where uploaded document bytes live. `local` writes under STORAGE__LOCAL_PATH;
# `r2` uses Cloudflare R2 over the S3 API. Selecting `r2` without the four R2
# values below fails at startup rather than silently writing to local disk.
STORAGE__MODE=local
STORAGE__LOCAL_PATH=var/storage
STORAGE__R2_ACCOUNT_ID=
STORAGE__R2_BUCKET=
STORAGE__R2_ACCESS_KEY_ID=
STORAGE__R2_SECRET_ACCESS_KEY=

# Qdrant vector store -- one collection per tenant. Deliberately NOT part of
# the /readyz dependency set: the API serves IAM traffic fine without it.
# Dev port is offset like Postgres (15432) and Redis (56379); a self-hosted
# production instance uses the standard 6333, which is the config default.
QDRANT__URL=http://localhost:56333
QDRANT__API_KEY=
QDRANT__TIMEOUT_SECONDS=30

# EMBEDDING_DIMENSIONS is requested from the embeddings API *and* used as the
# Qdrant collection's vector size, so the two cannot drift apart.
OPENAI__API_KEY=
OPENAI__EMBEDDING_MODEL=text-embedding-3-large
OPENAI__EMBEDDING_DIMENSIONS=3072
OPENAI__CHAT_MODEL=gpt-5.5

# How hard a reasoning model thinks before answering. Measured on gpt-5.5 with
# the real prompt, six questions each -- time to the first character:
#   unset:  median 2.11s, worst 10.80s
#   "low":  median 1.24s, worst  1.58s
# The median barely moves; the tail collapses. A reasoning model emits nothing
# while thinking, so an 11-second outlier is a visitor staring at an empty
# bubble. Grounded answering is extraction over passages the retriever already
# picked, so "low" costs no answer quality here.
# Leave BLANK for a non-reasoning model -- they reject the parameter outright.
# (gpt-5.5 accepts "low" and rejects "minimal".)
OPENAI__CHAT_REASONING_EFFORT=low
OPENAI__REQUEST_TIMEOUT_SECONDS=60

COHERE__API_KEY=
COHERE__RERANK_MODEL=rerank-v3.5

TAVILY__API_KEY=

# Chunking parameters (defaults from Architectural_Diagram.txt).
INGESTION__CHUNK_TOKENS=700
INGESTION__CHUNK_OVERLAP_TOKENS=100
INGESTION__TOKENIZER_ENCODING=cl100k_base

# PDF parsing strategy. Most business PDFs are text-native (exported from Word
# or a reporting tool) and carry the author's exact text in an embedded layer.
# Reading that layer is a parse; docling instead infers the text back from a
# rendered page image using ML layout models. Measured on a one-page PDF, warm
# process: docling 14,789.7ms vs text layer 10.9ms -- 1,351x.
#
# So the text layer is tried first and docling handles only what has no text
# layer (scans, image-only decks), where its OCR is the only thing that works.
# Set FIRST=false to force everything through docling, e.g. to compare output
# quality on a specific corpus.
INGESTION__PDF_TEXT_LAYER_FIRST=true
# A page with fewer characters than this counts as having no text -- enough to
# ignore a stray page number or scanner watermark.
INGESTION__PDF_MIN_CHARS_PER_PAGE=50
# Fraction of pages that must carry text before the fast path is trusted.
# Deliberately not 1.0: real reports contain full-page diagrams and blank
# separators, and one of those should not push a 100-page document through OCR.
INGESTION__PDF_MIN_TEXT_PAGE_RATIO=0.6
