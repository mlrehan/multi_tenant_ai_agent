# Copy to .env.local for local development.
#
# Server-only by design: there are deliberately no NEXT_PUBLIC_* variables,
# because the browser never talks to the backend directly -- every request
# goes through the same-origin BFF proxy at /api/backend/* (see README.md).
#
# Port 18000, not 8000: that's where `docker-compose.dev.yml` publishes the
# API container's port 8000 to your machine (see DEPLOYMENT.md Part A). If
# you're running the API natively instead (DEPLOYMENT.md's "Running natively"
# section), it listens on 8000 directly -- use that instead.
BACKEND_API_URL=http://localhost:18000
